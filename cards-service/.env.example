# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Classic PAT. Needs:
#   read:user    contribution calendar and profile totals
#   repo         read repo metadata for pin cards, and push the rendered cards
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# Whose profile to render.
GITHUB_LOGIN=gabriellaines

# Repo the rendered cards are committed into, and where inside it.
REPO_SLUG=gabriellaines/gabriellaines
REPO_BRANCH=main
REPO_SUBDIR=profile

# Repos to render pin cards for, in order. Only repos the token can see.
PIN_REPOS=jornada-milhas,rigdeck,chargeblast-challenge,termsheet-challenge

# Hostname Traefik routes to this service. Must have a DNS record pointing here
# before the container starts, or Let's Encrypt cannot issue a certificate.
CARDS_DOMAIN=cards.gabriellaines.dev

# How often to re-render and push.
RENDER_INTERVAL_HOURS=6

# Set to false to render without pushing, useful when first trying it out.
PUBLISH=true

# Per-client requests per minute allowed by the service itself.
RATE_LIMIT_PER_MINUTE=60
